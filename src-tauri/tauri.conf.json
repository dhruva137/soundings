{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundings",
  "version": "0.1.0",
  "identifier": "app.soundings.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Soundings",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Sound out your PC",
    "longDescription": "Disk map, duplicates, installed apps, developer runtimes, games and crash history for Windows."
  }
}
